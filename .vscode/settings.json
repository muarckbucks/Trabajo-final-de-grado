{
    "files.exclude": {
        "**/.git": true,
        "**/.svn": true,
        "**/.hg": true,
        "**/.DS_Store": true,
        "output/Thumbs.db": true,
        "output/*.aux": true,
        "output/*.log": true,
        "output/*.bbl": true,
        "output/*.bcf": true,
        "output/*.blg": true,
        "output/*.fdb_latexmk": true,
        "output/*.fls": true,
        "output/*.out": true,
        "output/*.xml": true,
        "output/*.gz": true,
        "output/*.bbl-SAVE-ERROR": true,
        "output/*.bcf-SAVE-ERROR": true,
        "output/*.bib": true,
        "output/capitulos": true,
        "output/*.toc": true,
        "node_modules": true,
        "package-lock.json": true,
        "package.json": true
    },
    "editor.quickSuggestions": {
    "other": false,
    "comments": false,
    "strings": false
    },
   "[latex]": {
    "editor.wordWrap": "on",
    "editor.lineNumbers": "relative",
    "files.autoSave": "off"
    },
    "latex-workshop.latex.outDir": "./output",
    "latex-workshop.latex.rootFile.useSubFile": false,
    "latex-workshop.latex.rootFile.doNotPrompt": true,
    "latex-workshop.latex.autoBuild.run": "onSave",
    "latex-workshop.latex.recipe.default": "latexmk",
}